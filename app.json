{
  "expo": {
    "name": "Makoma",
    "slug": "makoma",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.makoma.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#fff8f5",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.makoma.app"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      [
        "expo-audio",
        {
          "microphonePermission": "Makoma uses your microphone so you can send voice notes and record your voice intro."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Makoma uses your camera for selfie verification.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Makoma needs access to your photos so you can add them to your profile."
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#fff8f5",
          "image": "./assets/splash-icon.png",
          "imageWidth": 160
        }
      ]
    ],
    "scheme": "makoma",
    "experiments": {
      "typedRoutes": true
    }
  }
}
